# Meta Model API key for cloud inference (optional when using mock mode or local fallbacks)
META_API_KEY=your_meta_api_key_here

# Base URL for the Meta Model API service
META_API_BASE_URL=https://api.meta.ai/v1

# Primary model identifier for Muse Spark reasoning and triage assessment
MUSE_MODEL=muse-spark-1.3

# Alias model identifier for Muse Spark compatibility
MUSE_MODEL_NAME=muse-spark-1.3

# Primary model identifier for SAM 3.1 promptable concept segmentation
SAM_MODEL=sam-3.1

# Alias model identifier for SAM 3.1 compatibility
SAM_MODEL_NAME=sam-3.1

# Estimated billing cost in USD per image processed by SAM 3.1
SAM_COST_PER_IMAGE=0.0025

# Meta client mode: mock (offline fixtures), cached (cache/meta disk cache), or live (network calls)
SETU_META_MODE=mock

# Hard budget spending cap in USD before live Meta API requests are refused
SETU_BUDGET_CAP=50.0

# Filepath for logging API token usage and estimated dollar expenditures
USAGE_LOG_PATH=usage.jsonl

# Directory path storing cached Meta Model API responses
CACHE_META_DIR=cache/meta

# Enables offline geometric segmenter and rule-based assessor when Meta API is unavailable
USE_LOCAL_FALLBACKS=true

# Database connection URL for SQLite persistence via SQLModel
DATABASE_URL=sqlite:///./setu.db

# Network host address binding for the FastAPI Uvicorn web server
HOST=127.0.0.1

# Network port for the FastAPI Uvicorn web server
PORT=8000

# Application environment classification (development, testing, or production)
ENVIRONMENT=development

# Comma-separated list of allowed origins for Cross-Origin Resource Sharing
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# OpenStreetMap Overpass API interpreter endpoint for geographic bridge lookups
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Local directory path used for saving temporary raw video uploads
STORAGE_DIR=./uploads

# Bypasses video processing to return sample benchmark fixtures without API keys
SETU_DEMO_MODE=false

# Flag allowing live API integration tests to run during pytest execution
SETU_TEST_REAL_API=false

# Base backend URL targeted by the Vite frontend application
VITE_API_URL=http://localhost:8000

# Directs frontend to connect to the live backend server instead of local mock data
VITE_USE_REAL_BACKEND=true
