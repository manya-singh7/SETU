# Project SETU Environment Configuration

# Meta Model API (Used for Meta SAM 3.1 and Muse Spark 1.3)
META_API_KEY=your_meta_api_key_here
META_API_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
MUSE_MODEL_NAME=muse-spark-1.3
SAM_MODEL_NAME=facebook/sam3.1

# Meta Client Execution Mode (mock | cached | live)
# - mock: offline fixtures from tests/fixtures/ (zero network)
# - cached: calls API on cache miss, caches responses in CACHE_META_DIR
# - live: direct live API calls with token accounting
SETU_META_MODE=mock

# Hard Budget Cap in USD (live calls refused once reached)
SETU_BUDGET_CAP=50.0

# Usage Logging & Caching
USAGE_LOG_PATH=usage.jsonl
CACHE_META_DIR=cache/meta

# Fallback Mode: Set to "true" to use local simulated segmenter & rule-based assessor without API keys
USE_LOCAL_FALLBACKS=true

# Database Configuration (SQLite via SQLModel)
DATABASE_URL=sqlite:///./setu.db

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# OpenStreetMap Overpass API
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# File Upload Storage
STORAGE_DIR=./uploads
